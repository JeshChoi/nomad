generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  tokens AuthToken[]
  sources Source[]
  subjects Subject[]
  sessions LearningSession[]
}
model AuthToken {
  id String @id
  userId String
  expiresAt DateTime
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model Source {
  id String @id @default(cuid())
  userId String
  title String
  kind String
  rawText String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  objectives LearningObjective[]
}
model Subject {
  id String @id @default(cuid())
  userId String
  title String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  topics Topic[]
  sessions LearningSession[]
}
model Topic {
  id String @id @default(cuid())
  subjectId String
  title String
  sortOrder Int @default(0)
  subject Subject @relation(fields:[subjectId], references:[id], onDelete:Cascade)
  concepts Concept[]
}
model Concept {
  id String @id @default(cuid())
  topicId String
  title String
  description String
  topic Topic @relation(fields:[topicId], references:[id], onDelete:Cascade)
  objectives LearningObjective[]
}
model LearningObjective {
  id String @id @default(cuid())
  conceptId String
  statement String
  status String @default("SUGGESTED")
  sourceId String
  sourceExcerpt String
  sourceLocator String?
  createdAt DateTime @default(now())
  concept Concept @relation(fields:[conceptId], references:[id], onDelete:Cascade)
  source Source @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  review ReviewState?
  turns SessionTurn[]
  events AssessmentEvent[]
  selections SessionObjective[]
}
model LearningSession {
  id String @id @default(cuid())
  userId String
  subjectId String
  mode String
  style String
  targetMinutes Int
  status String @default("ACTIVE")
  startedAt DateTime @default(now())
  endedAt DateTime?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  subject Subject @relation(fields:[subjectId], references:[id], onDelete:Cascade)
  turns SessionTurn[]
  events AssessmentEvent[]
  objectives SessionObjective[]
  suggestions PendingSuggestion[]
  requests TurnRequest[]
}
model SessionObjective {
  sessionId String
  objectiveId String
  position Int
  session LearningSession @relation(fields:[sessionId], references:[id], onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId], references:[id], onDelete:Cascade)
  @@id([sessionId, objectiveId])
}
model SessionTurn {
  id String @id @default(cuid())
  sessionId String
  role String
  text String
  objectiveId String?
  createdAt DateTime @default(now())
  session LearningSession @relation(fields:[sessionId], references:[id], onDelete:Cascade)
  objective LearningObjective? @relation(fields:[objectiveId], references:[id], onDelete:SetNull)
  events AssessmentEvent[]
}
model AssessmentEvent {
  id String @id @default(cuid())
  sessionId String
  objectiveId String
  userTurnId String
  rating String
  evidenceSummary String
  rationale String
  confidence Float
  correctionOf String?
  createdAt DateTime @default(now())
  session LearningSession @relation(fields:[sessionId], references:[id], onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId], references:[id], onDelete:Cascade)
  userTurn SessionTurn @relation(fields:[userTurnId], references:[id], onDelete:Cascade)
}
model ReviewState {
  objectiveId String @id
  dueAt DateTime
  intervalDays Int @default(0)
  repetitions Int @default(0)
  easeFactor Float @default(2.5)
  lastRating String @default("UNASSESSED")
  updatedAt DateTime @updatedAt
  objective LearningObjective @relation(fields:[objectiveId], references:[id], onDelete:Cascade)
}
model PendingSuggestion {
  id String @id @default(cuid())
  sessionId String
  proposedObjective String
  rationale String
  status String @default("PENDING")
  session LearningSession @relation(fields:[sessionId], references:[id], onDelete:Cascade)
}
model TurnRequest {
  sessionId String
  key String
  result String
  session LearningSession @relation(fields:[sessionId], references:[id], onDelete:Cascade)
  @@id([sessionId,key])
}
model RateBucket {
  key String @id
  count Int
  expiresAt DateTime
}
